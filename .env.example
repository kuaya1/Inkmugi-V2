# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# NEVER commit your actual .env.local file to Git!

VITE_GEMINI_API_KEY=your-api-key-here

# EmailJS — required for the /contact form to send.
# Without all three the contact page shows phone / email / booking links instead
# of a form that cannot deliver. These are publishable client-side keys.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: Instagram feed on /gallery
VITE_INSTAGRAM_TOKEN=
